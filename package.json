{
  "name": "revserwis",
  "version": "2.0.0",
  "private": true,
  "description": "RevSerwis — strona z lokalnym SEO, wycena RevBot (Claude API), panel klienta /konto i aplikacja dla ekipy RevMi 2.0.0 (PWA): pulpit z prognozą przychodu, zlecenia, grafik, CRM, pakiety dla firm, budżety, raporty PDF, magazyn sprzętu, czas pracy z GPS, zarobki, czat zespołu, usterki i ranking.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build.js",
    "build:css": "node scripts/build-utilities.js",
    "icons": "node scripts/generate-icons.js",
    "vapid": "node scripts/generate-vapid.js",
    "test": "node --test tests/*.test.js",
    "migrate:photos": "node scripts/migrate-photos-r2.js",
    "favicons": "node scripts/generate-favicons.js",
    "site": "python3 scripts/site-generator/build_site.py",
    "pages": "node scripts/build-portal-pages.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-mongo": "^5.1.0",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.2",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4"
  }
}
