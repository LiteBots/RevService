{
  "name": "revserwis",
  "version": "3.1.0",
  "private": true,
  "description": "RevSerwis — strona firmowa oraz panel RevMi (PWA) z wycenami, zleceniami i powiadomieniami push",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build.js",
