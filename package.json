{
  "name": "revserwis",
  "version": "9.2.0",
  "private": true,
  "description": "RevSerwis 9.0 — strona z lokalnym SEO, wycena RevBot (Claude API), panel RevMi (PWA) oraz nowe moduły: panel klienta /konto ze śledzeniem zleceń i RevStorage, panele B2B (hotele i pensjonaty, biura nieruchomości), RevOutlet, RevPowrót, abonamenty i portal rekrutacyjny (działy, marketing, franczyza)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build.js",
    "build:css": "node scripts/build-utilities.js",
    "icons": "node scripts/generate-icons.js",
    "vapid": "node scripts/generate-vapid.js",
    "test": "node --test tests/*.test.js",
    "migrate:photos": "node scripts/migrate-photos-r2.js",
    "favicons": "node scripts/generate-favicons.js",
    "site": "python3 scripts/site-generator/build_site.py",
    "pages": "node scripts/build-portal-pages.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-mongo": "^5.1.0",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "nodemailer": "^6.10.1",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4"
  }
}
