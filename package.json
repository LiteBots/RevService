{
  "name": "revserwis",
  "version": "8.0.0",
  "private": true,
  "description": "RevSerwis 8.0 — strona z lokalnym SEO (5 usług × 6 miast), wycena RevBot (Claude API: analiza zdjęć, nauka na zleceniach, wiedza z internetu, ukryty cennik) oraz panel RevMi (PWA): oddziały, raport z zakończenia (zdjęcia, koszty), SMS z prośbą o opinię, rozliczenia pracowników, statystyki z podatkiem, duży notatnik",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build.js",
    "build:css": "node scripts/build-utilities.js",
    "icons": "node scripts/generate-icons.js",
    "vapid": "node scripts/generate-vapid.js",
    "test": "node --test tests/*.test.js",
    "favicons": "node scripts/generate-favicons.js",
    "site": "python3 scripts/site-generator/build_site.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-mongo": "^5.1.0",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0",
    "nodemailer": "^6.10.1",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4"
  }
}
