{
  "id": "/revmi/",
  "name": "RevMi 2.0 — RevSerwis",
  "short_name": "RevMi",
  "description": "Aplikacja ekipy RevSerwis: zlecenia, grafik, pulpit z prognozą, CRM, pakiety firm, czas pracy, zarobki i czat zespołu.",
  "lang": "pl",
  "dir": "ltr",
  "start_url": "/revmi/#/",
  "scope": "/revmi/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0c0f",
  "theme_color": "#0b0c0f",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/revmi/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/revmi/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/revmi/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Zlecenia", "url": "/revmi/#/zlecenia", "icons": [{ "src": "/revmi/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Grafik", "url": "/revmi/#/grafik", "icons": [{ "src": "/revmi/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Czat ekipy", "url": "/revmi/#/czat", "icons": [{ "src": "/revmi/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Czas pracy", "url": "/revmi/#/czas", "icons": [{ "src": "/revmi/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
